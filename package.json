{
  "name": "ai-workbench",
  "version": "0.3.0",
  "private": true,
  "description": "AI Unified Workbench with multi-agent workflow orchestration",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "dev:full": "concurrently \"pnpm server\" \"pnpm dev\"",
    "dev:electron": "concurrently \"vite\" \"pnpm electron\"",
    "electron": "electron .",
    "build": "vite build && pnpm build:electron",
    "build:electron": "tsc -p electron/tsconfig.json && electron-builder",
    "preview": "vite preview",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "pnpm typecheck:renderer && pnpm typecheck:electron && pnpm typecheck:server",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.6",
    "electron-store": "^10.0.0",
    "express": "^5.2.1",
    "js-yaml": "^4.1.0",
    "playwright": "^1.59.1",
    "puppeteer": "^24.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.ai-workbench.app",
    "productName": "AI Unified Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "workflows/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
